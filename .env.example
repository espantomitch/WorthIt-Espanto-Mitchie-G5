DJANGO_SECRET_KEY=replace-with-your-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_NAME=postgres
DB_USER=replace-with-your-postgres-username
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=replace-with-your-postgres-host
DB_PORT=5432
DB_SSLMODE=require
